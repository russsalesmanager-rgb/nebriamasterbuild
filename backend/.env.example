# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_NAME=nebria
DB_USER=nebria
DB_PASS=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# JWT Configuration (Use strong random strings in production)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
REFRESH_SECRET=your_refresh_secret_at_least_32_characters_long
JWT_EXPIRY=15m
REFRESH_EXPIRY=7d

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Storage Configuration (Cloudflare R2 / S3-compatible)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=nebria-media
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_REGION=auto
S3_FORCE_PATH_STYLE=false

# CORS Configuration
CORS_ORIGIN=http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=104857600
MAX_FILES_PER_REQUEST=10

# Admin Configuration
OWNER_EMAIL=owner@nebria.com
OWNER_USERNAME=owner
OWNER_PASSWORD=change_this_in_production

# Logging
LOG_LEVEL=info

# Socket.io
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Background Workers
WORKER_CONCURRENCY=5

# API Documentation
ENABLE_API_DOCS=true
API_DOCS_PATH=/api/docs

# Security
HELMET_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'

# Feature Flags
ENABLE_MEDIA_UPLOAD=true
ENABLE_AI_FEATURES=true
ENABLE_VR_FEATURES=true
ENABLE_MONETIZATION=true
